#!/usr/bin/env bash
# Control script for the isolated IM rebuild deployment.
set -euo pipefail
ROOT=/opt/IM-Rebuild
APP_ROOT="${ROOT}"
UNIT=im-rebuild
PORT=8198
VERIFY_MODE=0
MYSQL_DB=im
MYSQL_USER=im_app
if [ "${1:-}" = "--verify" ]; then
  shift
  VERIFY_MODE=1
  APP_ROOT="${ROOT}/canary-v07"
  UNIT=im-rebuild-verify
  PORT=8199
  MYSQL_DB=im_v07_verify
  MYSQL_USER=im_v07_verify
fi
ADDR="0.0.0.0:${PORT}"
BASELINE="${ROOT}/preflight/host.before"

RUNTIME_DIR="${ROOT}/runtime/docker"
RUNTIME_UNIT=im-rebuild-docker
DOCKER_SOCK="unix://${ROOT}/runtime/run/docker.sock"

MYSQL_NAME=im-rebuild-mysql
MYSQL_PORT=13307
MYSQL_DATA="${ROOT}/mysql/data"
MYSQL_SECRETS="${ROOT}/mysql/secrets"
MYSQL_ROOT_SECRET="${MYSQL_SECRETS}/mysql-root"
MYSQL_APP_SECRET="${MYSQL_SECRETS}/mysql-app"
CONFIG_DIR="${ROOT}/config"
BACKEND_APP_SECRET="${CONFIG_DIR}/mysql-app"
INFRA_ROOT="${ROOT}/infra-v11"
INFRA_SECRETS="${INFRA_ROOT}/secrets"
INFRA_CONFIG_DIR="${CONFIG_DIR}/infra-v11"
INFRA_REDIS_URL_FILE="${INFRA_CONFIG_DIR}/redis-url"
INFRA_REDIS_PASSWORD_FILE="${INFRA_CONFIG_DIR}/redis-password"
INFRA_RABBITMQ_URL_FILE="${INFRA_CONFIG_DIR}/rabbitmq-url"
INFRA_RABBITMQ_PASSWORD_FILE="${INFRA_CONFIG_DIR}/rabbitmq-password"
if [ "${VERIFY_MODE}" = "1" ]; then
  BACKEND_APP_SECRET="${APP_ROOT}/mysql-app"
  INFRA_CONFIG_DIR="${APP_ROOT}/config/infra-v13-verify"
  INFRA_REDIS_URL_FILE="${INFRA_CONFIG_DIR}/redis-url"
  INFRA_REDIS_PASSWORD_FILE="${INFRA_CONFIG_DIR}/redis-password"
  INFRA_RABBITMQ_URL_FILE="${INFRA_CONFIG_DIR}/rabbitmq-url"
  INFRA_RABBITMQ_PASSWORD_FILE="${INFRA_CONFIG_DIR}/rabbitmq-password"
fi

D() { "${RUNTIME_DIR}/docker" --host "${DOCKER_SOCK}" "$@"; }

snapshot() {
  /sbin/iptables-save | grep -v '^#' | sed -E 's/\[[0-9]+:[0-9]+\]/[COUNTERS]/'
  printf 'ip_forward=%s\n' "$(cat /proc/sys/net/ipv4/ip_forward)"
  /sbin/ip -o link show
  ps -C nginx,hhvm_bin -o pid=,lstart=,comm= | sort || true
}

wait_ready() {
  local attempt code
  for attempt in $(seq 1 40); do
    code="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 2 "http://127.0.0.1:${PORT}/ready" || true)"
    if [ "${code}" = "200" ]; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

runtime_start() {
  if D info >/dev/null 2>&1; then
    return 0
  fi
  test -x "${RUNTIME_DIR}/dockerd"
  mkdir -p "${ROOT}/runtime/run" "${ROOT}/runtime/data" "${ROOT}/logs"
  if systemctl is-failed --quiet "${RUNTIME_UNIT}"; then
    systemctl reset-failed "${RUNTIME_UNIT}"
  fi
  systemd-run --unit="${RUNTIME_UNIT}" --description="IM rebuild private Docker runtime" \
    --property=CPUAccounting=yes --property=CPUQuota=50% \
    --property=MemoryAccounting=yes --property=MemoryLimit=536870912 \
    /usr/bin/env "PATH=${RUNTIME_DIR}:/usr/sbin:/usr/bin:/sbin:/bin" "${RUNTIME_DIR}/dockerd" \
    --host "${DOCKER_SOCK}" --group root \
    --data-root "${ROOT}/runtime/data" --exec-root "${ROOT}/runtime/run" \
    --pidfile "${ROOT}/runtime/run/dockerd.pid" --storage-driver overlay2 \
    --bridge none --iptables=false --ip6tables=false --ip-forward=false --ip-masq=false \
    --userland-proxy=false --exec-opt native.cgroupdriver=cgroupfs \
    --log-level warn --default-ulimit nofile=8192:8192 >/dev/null
  local attempt
  for attempt in $(seq 1 40); do
    if D info >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  journalctl -u "${RUNTIME_UNIT}" --no-pager -n 40 >&2 || true
  return 1
}

runtime_stop() {
  if systemctl is-active --quiet "${RUNTIME_UNIT}"; then
    systemctl stop "${RUNTIME_UNIT}"
  fi
  if systemctl is-failed --quiet "${RUNTIME_UNIT}"; then
    systemctl reset-failed "${RUNTIME_UNIT}"
  fi
}

write_protected_file() {
  local content="$1" target="$2" temporary
  temporary="$(mktemp "${target}.tmp.XXXXXX")"
  printf '%s\n' "${content}" > "${temporary}"
  install -o nobody -g root -m 0400 "${temporary}" "${target}"
  rm -f "${temporary}"
}

prepare_backend_config() {
  mkdir -p "${CONFIG_DIR}" "${INFRA_CONFIG_DIR}"
  chmod 755 "${CONFIG_DIR}" "${INFRA_CONFIG_DIR}"
  if [ "${VERIFY_MODE}" = "1" ]; then
    test -s "${BACKEND_APP_SECRET}"
  else
    install -o nobody -g root -m 0400 "${MYSQL_APP_SECRET}" "${BACKEND_APP_SECRET}"
  fi

  if [ -s "${INFRA_SECRETS}/redis-password" ] \
    && [ -s "${INFRA_SECRETS}/rabbitmq-password" ]; then
    install -o nobody -g root -m 0400 \
      "${INFRA_SECRETS}/redis-password" "${INFRA_REDIS_PASSWORD_FILE}"
    install -o nobody -g root -m 0400 \
      "${INFRA_SECRETS}/rabbitmq-password" "${INFRA_RABBITMQ_PASSWORD_FILE}"
    if [ "${VERIFY_MODE}" = "1" ]; then
      write_protected_file \
        "redis://127.0.0.1:26379/1" "${INFRA_REDIS_URL_FILE}"
      write_protected_file \
        "amqp://im_v11@127.0.0.1:25676/im_v13_verify" "${INFRA_RABBITMQ_URL_FILE}"
    else
      write_protected_file \
        "redis://127.0.0.1:26379/0" "${INFRA_REDIS_URL_FILE}"
      write_protected_file \
        "amqp://im_v11@127.0.0.1:25676/im_v11" "${INFRA_RABBITMQ_URL_FILE}"
    fi
  fi
}

mysql_start() {
  runtime_start
  test -s "${MYSQL_ROOT_SECRET}"
  test -s "${MYSQL_APP_SECRET}"
  mkdir -p "${MYSQL_DATA}"
  if D container inspect "${MYSQL_NAME}" >/dev/null 2>&1; then
    if [ "$(D inspect -f '{{.State.Running}}' "${MYSQL_NAME}")" != "true" ]; then
      D start "${MYSQL_NAME}" >/dev/null
    fi
  else
    D run -d --name "${MYSQL_NAME}" --network host --restart=no \
      --cpus 0.5 --memory 512m --memory-swap 512m --pids-limit 192 \
      --mount "type=bind,src=${MYSQL_DATA},dst=/var/lib/mysql" \
      --mount "type=bind,src=${MYSQL_ROOT_SECRET},dst=/run/secrets/mysql-root,readonly" \
      --mount "type=bind,src=${MYSQL_APP_SECRET},dst=/run/secrets/mysql-app,readonly" \
      --env MYSQL_ROOT_PASSWORD_FILE=/run/secrets/mysql-root \
      --env MYSQL_DATABASE=im --env MYSQL_USER=im_app \
      --env MYSQL_PASSWORD_FILE=/run/secrets/mysql-app \
      --log-driver=json-file --log-opt max-size=10m --log-opt max-file=2 \
      mysql:8.4 --port="${MYSQL_PORT}" --bind-address=127.0.0.1 --mysqlx=OFF \
      --max-connections=50 --innodb-buffer-pool-size=128M --performance-schema=OFF \
      --innodb-redo-log-capacity=16M --skip-log-bin \
      --character-set-server=utf8mb4 --collation-server=utf8mb4_0900_ai_ci >/dev/null
  fi
  local attempt
  for attempt in $(seq 1 60); do
    if D exec "${MYSQL_NAME}" mysqladmin --protocol=tcp --host=127.0.0.1 --port="${MYSQL_PORT}" ping --silent >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  D logs --tail 60 "${MYSQL_NAME}" >&2 || true
  return 1
}

mysql_stop() {
  if D info >/dev/null 2>&1; then
    if D container inspect "${MYSQL_NAME}" >/dev/null 2>&1; then
      D stop "${MYSQL_NAME}" >/dev/null || true
    fi
  fi
}

mysql_status() {
  if ! D info >/dev/null 2>&1; then
    echo "mysql: runtime stopped"
    return 0
  fi
  if ! D container inspect "${MYSQL_NAME}" >/dev/null 2>&1; then
    echo "mysql: not created"
    return 0
  fi
  local state
  state="$(D inspect -f '{{.State.Status}}' "${MYSQL_NAME}")"
  echo "mysql: ${state} (127.0.0.1:${MYSQL_PORT})"
  if [ "${state}" = "running" ]; then
    D stats --no-stream --format '  memory={{.MemUsage}} cpu={{.CPUPerc}}' "${MYSQL_NAME}" 2>/dev/null || true
  fi
}

backend_stop() {
  if systemctl is-active --quiet "${UNIT}"; then
    systemctl stop "${UNIT}"
  fi
  if systemctl is-failed --quiet "${UNIT}"; then
    systemctl reset-failed "${UNIT}"
  fi
}

infra_ready() {
  [ -s "${INFRA_REDIS_URL_FILE}" ] \
    && [ -s "${INFRA_REDIS_PASSWORD_FILE}" ] \
    && [ -s "${INFRA_RABBITMQ_URL_FILE}" ] \
    && [ -s "${INFRA_RABBITMQ_PASSWORD_FILE}" ]
}

backend_env_args() {
  printf '%s\n' \
    "IM_MYSQL_HOST=127.0.0.1" \
    "IM_MYSQL_PORT=${MYSQL_PORT}" \
    "IM_MYSQL_DB=${MYSQL_DB}" \
    "IM_MYSQL_USER=${MYSQL_USER}" \
    "IM_MYSQL_PASSWORD_FILE=${BACKEND_APP_SECRET}"
  if infra_ready; then
    printf '%s\n' \
      "IM_REDIS_URL_FILE=${INFRA_REDIS_URL_FILE}" \
      "IM_REDIS_PASSWORD_FILE=${INFRA_REDIS_PASSWORD_FILE}" \
      "IM_RABBITMQ_URL_FILE=${INFRA_RABBITMQ_URL_FILE}" \
      "IM_RABBITMQ_PASSWORD_FILE=${INFRA_RABBITMQ_PASSWORD_FILE}" \
      "IM_REDIS_DB=$([ "${VERIFY_MODE}" = "1" ] && printf '1' || printf '0')" \
      "IM_MESSAGING_NAMESPACE=$([ "${VERIFY_MODE}" = "1" ] && printf 'im:v13-verify' || printf 'im:v12')" \
      "IM_GROUP_MESSAGING_ENABLED=true" \
      "IM_MESSAGING_REQUIRED=$([ "${VERIFY_MODE}" = "1" ] && printf 'true' || printf 'false')"
  fi
}

backfill_read() {
  prepare_backend_config
  if ! infra_ready; then
    echo "direct read backfill requires Redis configuration" >&2
    return 1
  fi
  local -a env_args=()
  local line
  while IFS= read -r line; do
    env_args+=("${line}")
  done < <(backend_env_args)
  /usr/bin/env "${env_args[@]}" \
    "${APP_ROOT}/bin/im-server" -backfill-read \
    -backfill-batch "${BACKFILL_BATCH:-1000}"
}

backend_start() {
  if systemctl is-active --quiet "${UNIT}"; then
    echo "backend is already running on port ${PORT}"
    wait_ready
    return
  fi
  if systemctl is-failed --quiet "${UNIT}"; then
    systemctl reset-failed "${UNIT}"
  fi
  test -x "${APP_ROOT}/bin/im-server"
  test -f "${APP_ROOT}/web/index.html"
  local listeners
  listeners="$(ss -lnt | awk '{print $4}')"
  if grep -q ":${PORT}\$" <<<"${listeners}"; then
    echo "Port ${PORT} is already in use; refusing to start." >&2
    return 1
  fi
  if [ ! -f "${BASELINE}" ]; then
    snapshot > "${BASELINE}"
  fi
  prepare_backend_config
  local -a env_args=()
  local line
  while IFS= read -r line; do
    env_args+=("${line}")
  done < <(backend_env_args)
  if [ "${VERIFY_MODE}" = "1" ] && ! infra_ready; then
    echo "verification backend requires isolated Redis and RabbitMQ configuration" >&2
    return 1
  fi
  systemd-run --unit="${UNIT}" --description="IM rebuild backend" \
    --uid=nobody --gid=nobody \
    --property=CPUAccounting=yes --property=CPUQuota=25% \
    --property=MemoryAccounting=yes --property=MemoryLimit=134217728 \
    /usr/bin/env "${env_args[@]}" \
    "${APP_ROOT}/bin/im-server" -addr "${ADDR}" -web-dir "${APP_ROOT}/web"
  if wait_ready; then
    echo "IM rebuild backend is ready on port ${PORT}"
  else
    journalctl -u "${UNIT}" --no-pager -n 30
    return 1
  fi
}

start() {
  if [ "${VERIFY_MODE}" = "1" ]; then
    D info >/dev/null
    test "$(D inspect -f '{{.State.Running}}' "${MYSQL_NAME}")" = "true"
  else
    mysql_start
  fi
  backend_start
}

stop() {
  backend_stop
  if [ "${VERIFY_MODE}" != "1" ]; then
    mysql_stop
    runtime_stop
  fi
  echo "IM rebuild stopped; files and MySQL data are kept."
}

restart() {
  if [ "${VERIFY_MODE}" = "1" ]; then
    backend_stop
    start
  else
    mysql_start
    backend_stop
    backend_start
  fi
}

health() {
  local endpoint code failed=0
  for endpoint in health ready; do
    if code="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' --max-time 3 "http://127.0.0.1:${PORT}/${endpoint}")"; then
      printf '%s: HTTP %s\n' "${endpoint}" "${code}"
      if [ "${code}" != "200" ]; then failed=1; fi
    else
      printf '%s: unreachable\n' "${endpoint}" >&2
      failed=1
    fi
  done
  return "${failed}"
}

status() {
  if systemctl is-active --quiet "${UNIT}"; then
    echo "backend: running (port ${PORT})"
    systemctl show "${UNIT}" -p MainPID -p MemoryCurrent -p ActiveEnterTimestamp | sed 's/^/  /'
    printf '  health: '
    curl --silent --max-time 2 "http://127.0.0.1:${PORT}/health" || printf 'unreachable'
    printf '\n'
    printf '  ready: '
    curl --silent --max-time 2 "http://127.0.0.1:${PORT}/ready" || printf 'unavailable'
    printf '\n'
  else
    echo "backend: stopped"
  fi
  mysql_status
  if D info >/dev/null 2>&1; then
    echo "docker: running ($(D info --format '{{.ServerVersion}}' 2>/dev/null))"
  else
    echo "docker: stopped"
  fi
  if [ -f "${APP_ROOT}/RELEASE" ]; then
    sed 's/^/  /' "${APP_ROOT}/RELEASE"
  fi
}

logs() {
  local service="${1:-backend}" lines="${2:-80}"
  case "${service}" in
    backend) journalctl -u "${UNIT}" --no-pager -n "${lines}" ;;
    mysql) D logs --tail "${lines}" "${MYSQL_NAME}" ;;
    runtime) journalctl -u "${RUNTIME_UNIT}" --no-pager -n "${lines}" ;;
    *) echo "Usage: $0 logs [backend|mysql|runtime] [lines]" >&2; return 2 ;;
  esac
}

verify_host() {
  if [ ! -f "${BASELINE}" ]; then
    echo "No host baseline recorded." >&2
    return 1
  fi
  if diff "${BASELINE}" <(snapshot) >/dev/null; then
    echo "firewall rules, IP forwarding, interfaces and existing web processes unchanged"
  else
    echo "Host state differs from the recorded baseline:" >&2
    diff "${BASELINE}" <(snapshot) >&2 || true
    return 1
  fi
}

# Credentials stay in a short-lived option file inside the existing container.
# stdin is left available for SQL/dump data, and the trap removes the option file.
mysql_command() {
  D exec -i "${MYSQL_NAME}" sh -c '
    set -eu
    umask 077
    config=$(mktemp /tmp/im-admin.XXXXXX)
    trap '\''rm -f "$config"'\'' EXIT
    password=$(sed '\''s/\\/\\\\/g; s/"/\\"/g'\'' /run/secrets/mysql-root)
    printf '\''[client]\nuser=root\npassword="%s"\nhost=127.0.0.1\nport=%s\nprotocol=tcp\n'\'' "$password" "$1" > "$config"
    unset password
    shift
    command=$1
    shift
    "$command" --defaults-extra-file="$config" "$@"
  ' im-admin "${MYSQL_PORT}" "$@"
}

backup() (
  set -euo pipefail
  umask 077
  local destination
  mkdir -p "${APP_ROOT}/backups"
  chmod 700 "${APP_ROOT}/backups"
  destination="$(mktemp -d "${APP_ROOT}/backups/$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")"
  touch "${destination}/.incomplete"
  mysql_command mysqldump --single-transaction --skip-extended-insert \
    --skip-comments --skip-add-locks --no-tablespaces --set-gtid-purged=OFF \
    --hex-blob "${MYSQL_DB}" > "${destination}/database.sql"
  awk '
    /^CREATE TABLE `/ { table=$3; gsub(/`/, "", table); counts[table]=0 }
    /^INSERT INTO `/ { table=$3; gsub(/`/, "", table); counts[table]++ }
    END { for (table in counts) print table "\t" counts[table] }
  ' "${destination}/database.sql" | LC_ALL=C sort > "${destination}/counts.tsv"
  test -s "${destination}/counts.tsv"
  mysql_command mysql --batch --skip-column-names "${MYSQL_DB}" \
    -e 'SELECT version FROM schema_migrations ORDER BY version' > "${destination}/migrations.tsv"
  mkdir "${destination}/bin"
  cp -p "${APP_ROOT}/bin/im-server" "${destination}/bin/im-server"
  cp -a "${APP_ROOT}/web" "${destination}/web"
  cp -p "${APP_ROOT}/RELEASE" "${destination}/RELEASE"
  printf 'database=%s\ncreated_at=%s\n' "${MYSQL_DB}" "$(date -u +%FT%TZ)" > "${destination}/source.txt"
  (
    cd "${destination}"
    find . -type f ! -name SHA256SUMS ! -name .incomplete -print0 | LC_ALL=C sort -z | xargs -0 sha256sum > SHA256SUMS
  )
  rm "${destination}/.incomplete"
  printf '%s\n' "${destination}"
)

restore_check() (
  set -euo pipefail
  umask 077
  local source scratch created=0 table expected actual table_count backup_root
  source="${1:?Usage: imctl restore-check <backup>}"
  source="$(cd "${source}" && pwd -P)"
  backup_root="$(cd "${APP_ROOT}/backups" && pwd -P)"
  case "${source}" in
    "${backup_root}/"*) ;;
    *) echo 'Backup must be under the selected application backup directory.' >&2; exit 2 ;;
  esac
  test ! -e "${source}/.incomplete"
  test -s "${source}/database.sql"
  test -s "${source}/counts.tsv"
  (cd "${source}" && sha256sum --check --strict SHA256SUMS >/dev/null) || exit 1
  if grep -Eiq '^(CREATE|DROP|ALTER)[[:space:]]+DATABASE|^USE[[:space:]]|^/\*![0-9]+[[:space:]]+(CREATE|DROP|ALTER)[[:space:]]+DATABASE|^/\*![0-9]+[[:space:]]+USE[[:space:]]' "${source}/database.sql"; then
    echo 'Dump contains database selection or database DDL; refusing restore.' >&2
    exit 2
  fi
  scratch="im_restore_$(date -u +%Y%m%d%H%M%S)_$$_${RANDOM}"
  trap 'if [ "${created}" = "1" ]; then mysql_command mysql -e "DROP DATABASE \`${scratch}\`"; fi' EXIT
  mysql_command mysql -e "CREATE DATABASE \`${scratch}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci" || exit 1
  created=1
  mysql_command mysql "${scratch}" < "${source}/database.sql" || exit 1
  table_count="$(mysql_command mysql --batch --skip-column-names -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${scratch}'")"
  test "${table_count}" = "$(wc -l < "${source}/counts.tsv" | tr -d ' ')" || exit 1
  while IFS=$'\t' read -r table expected; do
    if [[ ! "${table}" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ || ! "${expected}" =~ ^[0-9]+$ ]]; then
      echo 'Invalid table/count manifest.' >&2
      exit 2
    fi
    actual="$(mysql_command mysql --batch --skip-column-names "${scratch}" -e "SELECT COUNT(*) FROM \`${table}\`")"
    if [ "${actual}" != "${expected}" ]; then
      echo "Restored count mismatch for ${table}." >&2
      exit 1
    fi
  done < "${source}/counts.tsv"
  mysql_command mysql --batch --skip-column-names "${scratch}" \
    -e 'SELECT version FROM schema_migrations ORDER BY version' | cmp -s "${source}/migrations.tsv" - || exit 1
  mysql_command mysql -e "DROP DATABASE \`${scratch}\`" || exit 1
  created=0
  printf 'Restore verified: %s tables and migration versions; temporary database %s removed.\n' "${table_count}" "${scratch}"
)

main() {
  if [ "${VERIFY_MODE}" = "1" ]; then
    case "${1:-status}" in
      mysql-stop|runtime-stop|baseline) echo 'Shared infrastructure cannot be stopped/reset in verification mode.' >&2; return 2 ;;
    esac
  fi
  case "${1:-status}" in
    baseline) mkdir -p "${ROOT}/preflight"; snapshot > "${BASELINE}"; echo "baseline recorded" ;;
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    backend-start) backend_start ;;
    backend-stop) backend_stop ;;
    backfill-read) backfill_read ;;
    health) health ;;
    status) status ;;
    backup) backup ;;
    restore-check) restore_check "${2:-}" ;;
    mysql-start) mysql_start ;;
    mysql-stop) mysql_stop ;;
    mysql-status) mysql_status ;;
    runtime-start) runtime_start ;;
    runtime-stop) runtime_stop ;;
    verify-host) verify_host ;;
    logs) logs "${2:-backend}" "${3:-80}" ;;
    *) echo "Usage: $0 [--verify] {start|stop|restart|backend-start|backend-stop|backfill-read|health|status|backup|restore-check <backup>|mysql-start|mysql-stop|mysql-status|runtime-start|runtime-stop|verify-host|logs [backend|mysql|runtime] [lines]}" >&2; return 2 ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
